{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express.js backend with Clean Architecture",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "npm run test && npm run lint && prisma generate && tsc && cp -r src/generated dist/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db-update": "npm run db-extensions && npm run db-migrate-osm && npx prisma generate && npx prisma db push && npm run db-indexes",
    "db-extensions": "tsx src/scripts/enable-postgis.ts",
    "db-indexes": "tsx src/scripts/create-geo-indexes.ts",
    "db-migrate-osm": "tsx src/scripts/migrate-osm-data.ts",
    "db-seed": "tsx prisma/seed.ts",
    "import:overpass": "tsx src/scripts/import-overpass.ts",
    "import:osm": "tsx src/scripts/import-osm.ts",
    "import:geoapify": "tsx src/scripts/import-geoapify.ts",
    "import:csv": "tsx src/scripts/import-csv.ts",
    "import:data": "tsx src/scripts/import-data.ts",
    "import:dadosgov": "tsx src/scripts/import-dadosgov.ts",
    "import:caop": "tsx src/scripts/import-caop.ts",
    "set-admin": "tsx src/scripts/set-admin.ts",
    "clean:outside-portugal": "tsx src/scripts/clean-outside-portugal.ts",
    "update-deps": "npx npm-check-updates -i --format group",
    "prepare": "cd .. && husky backend/.husky || true"
  },
  "keywords": [
    "express",
    "typescript",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}