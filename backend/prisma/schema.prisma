// Parqi - Prisma schema
// PostgreSQL + PostGIS (geometry columns are `Unsupported`, manipulated via raw SQL)

generator client {
    provider        = "prisma-client-js"
    output          = "../src/generated/prisma"
    binaryTargets   = ["native", "debian-openssl-1.0.x"]
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    // A URL de conexão é definida em prisma.config.ts (env DATABASE_URL)
    provider   = "postgresql"
    extensions = [postgis]
}

// ─────────────────────────── Enums ───────────────────────────

enum UserRole {
    USER
    ADMIN
}

enum ParkingType {
    SURFACE
    UNDERGROUND
    MULTI_STORY
    STREET
    OTHER
}

enum CapacityRange {
    RANGE_1_5
    RANGE_6_20
    RANGE_21_50
    RANGE_51_100
    RANGE_100_PLUS
}

enum DataSource {
    COMMUNITY
    OVERPASS
    GEOAPIFY
    MUNICIPAL
}

enum ContributionStatus {
    PENDING
    APPROVED
    REJECTED
    FLAGGED
}

enum GeometryType {
    POINT
    POLYGON
    LINE
}

enum ModerationAction {
    APPROVE
    REJECT
}

enum SuggestionStatus {
    PENDING
    APPROVED
    REJECTED
}

// ─────────────────────────── Models ───────────────────────────

model User {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name     String
    email    String   @unique
    password String
    role     UserRole @default(USER)
    isActive Boolean  @default(true)

    // Verificação de email por código (6 dígitos, sha256, expira em 15 min)
    emailVerified              Boolean   @default(false)
    emailVerificationCode      String?
    emailVerificationExpires   DateTime?
    emailVerificationAttempts  Int       @default(0)
    emailVerificationSentAt    DateTime?

    contributions  ParkingSpot[]
    votes          ParkingVote[]
    moderationLogs ModerationLog[]
    suggestions    ParkingSuggestion[] @relation("SuggestionAuthor")
    reviewedSuggestions ParkingSuggestion[] @relation("SuggestionReviewer")

    @@index([id])
    @@index([email])
}

model ParkingSpot {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name          String
    description   String?
    latitude      Float?
    longitude     Float?
    // PostGIS: sempre um ponto (centroide/point-on-surface) + polígono opcional + linha opcional (na via)
    geom          Unsupported("geometry(Point, 4326)")?
    boundary      Unsupported("geometry(Polygon, 4326)")?
    path          Unsupported("geometry(LineString, 4326)")?
    geometryType  GeometryType                            @default(POINT)
    parkingType   ParkingType                             @default(OTHER)
    capacityRange CapacityRange?
    isFree        Boolean?

    // Detalhes de acessibilidade e serviços (contribuição da comunidade/importação)
    hasPregnantSpaces  Boolean?
    hasDisabledSpaces  Boolean?
    hasEvCharging      Boolean?
    isCovered          Boolean?

    source     DataSource         @default(COMMUNITY)
    externalId String? // e.g. "node:123" (OSM), "geoapify:abc123", "porto-citysdk:<id>"
    status     ContributionStatus @default(PENDING)
    trustScore Float              @default(0)
    // Novos membros / dados suspeitos: não pode auto-aprovar por votos até revisão manual (admin)
    requiresReview Boolean        @default(false)

    duplicateOfId String?
    duplicateOf   ParkingSpot?  @relation("DuplicateGroup", fields: [duplicateOfId], references: [id], onDelete: SetNull)
    duplicates    ParkingSpot[] @relation("DuplicateGroup")

    contributorId String?
    contributor   User?   @relation(fields: [contributorId], references: [id], onDelete: SetNull)

    // Concelho (CAOP) onde o parque se localiza — preenchido automaticamente na criação
    municipalityId String?
    municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

    votes          ParkingVote[]
    moderationLogs ModerationLog[]
    suggestions    ParkingSuggestion[]

    @@unique([source, externalId])
    @@index([status])
    @@index([source])
    @@index([latitude, longitude])
    @@index([duplicateOfId])
    @@index([municipalityId])
}

model ParkingVote {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())

    value  Int // 1 = upvote, -1 = downvote
    reason String? // obrigatório em votos negativos (porquê)
    // Peso do voto consoante a reputação do votante (novos votam com peso 0.5)
    weight Float @default(1)

    parkingSpotId String
    parkingSpot   ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, parkingSpotId])
    @@index([parkingSpotId])
}

model ModerationLog {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())

    action ModerationAction
    reason String?

    parkingSpotId String
    parkingSpot   ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)

    moderatorId String?
    moderator   User?   @relation(fields: [moderatorId], references: [id], onDelete: SetNull)

    @@index([parkingSpotId])
}

// Concelhos de Portugal (CAOP) — fronteiras oficiais para associar cada parque à sua área administrativa
model Municipality {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Código DIC (ex.: 1106 = Lisboa, 3103 = Funchal, 4203 = Ponta Delgada)
    dic          String?
    name         String
    distritoIlha String?
    nuts1        String?
    nuts2        String?
    nuts3        String?
    nuts3Cod     String?
    areaHa       Float?
    perimetroKm  Int?
    nFreguesias  Int?

    // PostGIS: geometria MultiPolygon dos limites do concelho (CAOP, WGS84)
    geom Unsupported("geometry(MultiPolygon, 4326)")?

    parkingSpots ParkingSpot[]

    @@unique([dic])
    @@index([name])
}

// Sugestões da comunidade para complementar/corrigir informação de parques existentes
model ParkingSuggestion {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Campos propostos (diff): { name?, description?, parkingType?, capacityRange?, isFree?, ... }
    data   Json
    status SuggestionStatus @default(PENDING)
    reason String? // motivo dado pelo autor / pelo revisor

    reviewedAt DateTime?

    parkingSpotId String
    parkingSpot   ParkingSpot @relation(fields: [parkingSpotId], references: [id], onDelete: Cascade)

    suggestedById String
    suggestedBy   User   @relation("SuggestionAuthor", fields: [suggestedById], references: [id], onDelete: Cascade)

    reviewedById String?
    reviewedBy   User?  @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

    @@index([status])
    @@index([parkingSpotId])
    @@index([suggestedById])
}
