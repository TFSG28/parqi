{
    "project": {
        "name": "Perfect Template",
        "description": "Full-stack template with Clean Architecture and SOLID principles",
        "version": "1.0.0",
        "type": "full-stack"
    },
    "stack": {
        "backend": {
            "framework": "Express.js",
            "language": "TypeScript",
            "orm": "Prisma",
            "testing": "Vitest",
            "di": "TSyringe"
        },
        "frontend": {
            "framework": "Next.js 16",
            "library": "React 19",
            "styling": "Tailwind CSS 4",
            "testing": "Vitest"
        }
    },
    "architecture": {
        "pattern": "Clean Architecture",
        "principles": [
            "SOLID",
            "DRY",
            "KISS"
        ],
        "layers": {
            "domain": "Business rules and entities",
            "application": "Use cases and DTOs",
            "infrastructure": "External implementations",
            "presentation": "Controllers and routes"
        }
    },
    "conventions": {
        "language": "Portuguese",
        "codeStyle": "Clean Code",
        "testing": "AAA Pattern",
        "api": "RESTful",
        "commits": "Conventional Commits"
    },
    "security": {
        "authentication": "JWT",
        "passwordHashing": "bcryptjs",
        "encryption": "AES-256-CBC",
        "cors": "Configured",
        "rateLimiting": "Enabled"
    },
    "documentation": {
        "readme": "README.md",
        "setup": "SETUP.md",
        "architecture": "ARCHITECTURE.md",
        "api": "API.md",
        "testing": "TESTING.md",
        "contributing": "CONTRIBUTING.md",
        "deployment": "DEPLOYMENT.md",
        "moduleTemplate": "MODULE_TEMPLATE.md",
        "checklist": "CHECKLIST.md"
    },
    "steering": {
        "location": ".kiro/steering/",
        "autoIncluded": [
            "00-template-overview.md",
            "01-development-workflow.md",
            "05-security-best-practices.md",
            "07-api-design.md"
        ],
        "manual": [
            "02-creating-modules.md",
            "03-frontend-development.md",
            "04-testing-guide.md",
            "06-database-patterns.md",
            "08-deployment.md",
            "09-troubleshooting.md"
        ]
    },
    "scripts": {
        "setup": {
            "windows": "setup.bat",
            "powershell": "setup.ps1",
            "unix": "setup.sh"
        },
        "backend": {
            "dev": "npm run dev",
            "build": "npm run build",
            "test": "npm test",
            "dbUpdate": "npm run db-update"
        },
        "frontend": {
            "dev": "npm run dev",
            "build": "npm run build",
            "test": "npm test"
        }
    },
    "ports": {
        "backend": 3001,
        "frontend": 3000
    }
}