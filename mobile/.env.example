# Parqi Mobile — Environment Variables
# Copia este ficheiro para .env e preenche os valores reais.
# NUNCA comites o .env com valores reais (já está no .gitignore).

# URL da API Parqi (produção ou local)
EXPO_PUBLIC_API_URL=https://api.parqi.pt/api/v1

# Fornecedor do mapa: "osm" (default, Expo Go), "mapbox" ou "google"
# "mapbox" usa o Mapbox Maps SDK nativo: requer development build Android
EXPO_PUBLIC_MAP_PROVIDER=osm

# Token público Mapbox (começa por pk.). Pode ser exposto no bundle da app.
# No desenvolvimento local, MAPBOX_ACCESS_TOKEN no backend/.env também é aceite pelo app.config.ts.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Token secreto Mapbox com DOWNLOADS:READ, apenas durante o build nativo.
# Define-o no ambiente como RNMAPBOX_MAPS_DOWNLOAD_TOKEN.

# Google Maps API Key (necessária para react-native-maps no Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Expo Project ID (para notificações push) — obtém em expo.dev
EXPO_PUBLIC_PROJECT_ID=

